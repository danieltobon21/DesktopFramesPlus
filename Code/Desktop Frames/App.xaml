<Application x:Class="Desktop_Frames.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Desktop_Frames" Startup="Application_Startup">
    <Application.Resources>
        <!-- El tema de WPF-UI (Fluent) NO se declara aqui: se aplica solo en la ventana
             "Acerca de" (ver AboutFormManager). En el resto de dialogos la app pinta todos
             los colores a mano y el tema dejaba controles ilegibles: el desplegable de
             Opciones se quedaba sin texto porque el tema hereda el modo oscuro de Windows y
             pinta el texto con sus pinceles claros sobre las superficies blancas de la app. -->
    </Application.Resources>
</Application>
